# リポジトリのルートはサーバ上の REPO (既定は /home/isucon)。ルート直下は全部無視して、必要なものだけ許可する
/*
!/.gitignore
!/.claude/
!/Makefile
!/mk/
!/README.md
!/env.sh
!/env.sh.example
!/ssh_config.example
!/etc/
!/tools/
!/notes/
# 配布物のディレクトリの許可と、取り込まない巨大ファイル・バイナリの除外は、make webapp-pull が末尾に書く
# (mk/vars.mk の EXEC / EXCLUDE から決まる。ここには書かない)

# TLS 秘密鍵はリポジトリに入れない (deploy の rsync は --delete なしなのでサーバ側は残る)
/etc/nginx/ssl/
*.pprof
/log/
