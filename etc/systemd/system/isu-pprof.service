# CPU プロファイルを取り続ける (tools/pprof-loop.sh)。make deploy がアプリの台で有効にして起動し直す
# ExecStart のパスは REPO (/home/isucon) の下。REPO を変えたらここも直す
[Unit]
Description=isucon: CPU プロファイルを 10 秒ずつ取り続ける
After=network.target

[Service]
ExecStart=/bin/bash /home/isucon/tools/pprof-loop.sh
Restart=always

[Install]
WantedBy=multi-user.target
